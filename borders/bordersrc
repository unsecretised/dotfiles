#!/bin/bash

BG_BASE="0x1f1f28"
BG_SURFACE="0x2a2a37"
BG_OVERLAY="0x363646"

FG_PRIMARY="0xdcd7ba"
FG_SECONDARY="0xc8c093"
FG_DIM="0x727169"

# Helper: convert 0xRRGGBB → 0xAARRGGBB with given alpha byte
# Usage: with_alpha <0xRRGGBB> <AA>
# e.g.  with_alpha "$FG_PRIMARY" "ff"
with_alpha() {
  echo "0x${2}${1:2}"
}

options=(
  style=round
  width=2.0
  hidpi=on
  active_color=$(with_alpha "$FG_PRIMARY" "cc")
  inactive_color=$(with_alpha "$FG_DIM" "40")
  blacklist="Sxitch","sxitch"
)

borders "${options[@]}"
