.{
    .keybinds = .{
        .{ .key = "1", .mods = .{ .alt = true }, .action = .focus_workspace, .arg = 1 },
        .{ .key = "2", .mods = .{ .alt = true }, .action = .focus_workspace, .arg = 2 },
        .{ .key = "3", .mods = .{ .alt = true }, .action = .focus_workspace, .arg = 3 },
        .{ .key = "4", .mods = .{ .alt = true }, .action = .focus_workspace, .arg = 4 },
        .{ .key = "5", .mods = .{ .alt = true }, .action = .focus_workspace, .arg = 5 },
        .{ .key = "f", .mods = .{ .alt = true, .shift = true }, .action = .toggle_float },
        .{ .key = "g", .mods = .{ .alt = true }, .action = .resize_grow },
        .{ .key = "s", .mods = .{ .alt = true }, .action = .resize_shrink },

        .{ .key = "1", .mods = .{ .cmd = true, .alt = true }, .action = .move_to_workspace, .arg = 1 },
        .{ .key = "2", .mods = .{ .cmd = true, .alt = true }, .action = .move_to_workspace, .arg = 2 },
        .{ .key = "3", .mods = .{ .cmd = true, .alt = true }, .action = .move_to_workspace, .arg = 3 },
        .{ .key = "4", .mods = .{ .cmd = true, .alt = true }, .action = .move_to_workspace, .arg = 4 },
        .{ .key = "5", .mods = .{ .cmd = true, .alt = true }, .action = .move_to_workspace, .arg = 5 },
        .{ .key = "e", .mods = .{ .cmd = true, .shift = true }, .action = .move_workspace_to_display, .arg = 2 },
        .{ .key = "i", .mods = .{ .cmd = true, .shift = true }, .action = .move_workspace_to_display, .arg = 1 },

        .{ .key = "h", .mods = .{ .cmd = true, .shift = true }, .action = .focus_left },
        .{ .key = "l", .mods = .{ .cmd = true, .shift = true }, .action = .focus_right },
        .{ .key = "up", .mods = .{ .cmd = true }, .action = .focus_up },
        .{ .key = "down", .mods = .{ .cmd = true }, .action = .focus_down },
    },
    .bsp_split_ratio = 0.5,
    .workspace_assignments = .{
        .{ .app_id = "com.spotify.client", .workspace = 1 },
        .{ .app_id = "com.apple.Music", .workspace = 1 },
        .{ .app_id = "com.mitchellh.ghostty", .workspace = 4 },
        .{ .app_id = "app.zen-browser.zen", .workspace = 5 },
        .{ .app_id = "net.imput.helium", .workspace = 5 },
        .{ .app_id = "com.hnc.Discord", .workspace = 2 },
        .{ .app_id = "dev.vencord.vesktop", .workspace = 2 },
        .{ .app_id = "md.obsidian", .workspace = 3 },
        .{ .app_id = "com.apple.iCal", .workspace = 3 },
        .{ .app_id = "com.apple.reminders", .workspace = 3 },
        .{ .app_id = "com.umangsurana.idiot", .workspace = 1 },
    },
    .gaps = .{
        .inner = 10,
        .outer = .{ .left = 10, .right = 10, .top = 10, .bottom = 10 },
    },
    .swipe = .{ .enabled = false, .fingers = 3, .distance_pct = 0.01, .reverse = false },
    .animation = .{
        .enabled = true,
    },
    .dimmed_inactive = .{
        .enabled = false,
        .level = 0.25,
    },
    .auto_reload_config = true,
    .layout = .bsp,
    .workspace_names = .{ "A", "B", "C", "D", "E" },
    .start_at_login = true,
}

